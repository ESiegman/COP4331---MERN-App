# For running the API outside Docker
PORT=5001
MONGODB_URI=mongodb://app:apppassword@localhost:27017/app?directConnection=true
JWT_SECRET=dev-secret
# How long a login lasts
JWT_EXPIRES_IN=7d
# Where the web app is served. Links in verification and reset emails point here.
APP_URL=http://localhost:5173
# Optional: send real email through an SMTP server. Without it, emails are written to the log.
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# EMAIL_FROM=Tier List <no-reply@example.com>
# Optional: Claude API key for AI item suggestions. Without it, suggest-items answers 501.
# ANTHROPIC_API_KEY=
# Optional: log in with Google and Discord. A provider without both answers 501.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Redirect URIs clients may use for them, comma-separated. Defaults to APP_URL/oauth/callback.
# OAUTH_REDIRECT_URIS=
