# For running the API outside Docker
PORT=5001
MONGODB_URI=mongodb://app:apppassword@localhost:27017/app?directConnection=true
JWT_SECRET=dev-secret
# How long a login lasts
JWT_EXPIRES_IN=7d
# Where the web app is served. Links in verification and reset emails point here.
APP_URL=http://localhost:5173
# Optional: send real email through an SMTP server. Without it, emails are written to the log.
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# EMAIL_FROM=Tier List <no-reply@example.com>
