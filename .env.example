# Optional for local dev: compose.yaml has working defaults for all of these.
# Copy to .env to override them. In production, the real values live in
# /opt/mern/.env on the droplet (generated by deploy/bootstrap-droplet.sh).
# Use URL-safe passwords (e.g. `openssl rand -hex 24`): they go into mongodb:// URIs.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=devpassword
MONGO_APP_DB=app
MONGO_APP_USER=app
MONGO_APP_PASSWORD=apppassword
